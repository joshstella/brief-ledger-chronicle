.DS_Store

# chronicle.md is the one committed rendering. Other files under this folder stay
# ignored so a later archive feature has a place. install.sh writes this same pair
# into every target it scaffolds a chronicles directory for.
docs/chronicles/*
!docs/chronicles/chronicle.md

# Your global ignore (~/.config/git/ignore) carries `**/.claude/settings.local.json`.
# That is right for a project — a local permission allowlist is not shared state — but
# wrong here: this repo *ships* that file as the template install.sh copies out. A repo
# .gitignore outranks core.excludesFile, so this negation is what keeps the template
# tracked. Without it git drops the file silently and install.sh dies at step 8.
!templates/.claude/settings.local.json
