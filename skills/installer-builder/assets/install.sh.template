#!/usr/bin/env bash
# install.sh — generated by the installer-builder skill.
# Mirrors payload/ into a destination root. Safe to re-run: anything it would
# overwrite is backed up first. Override the destination with <DEST_ENV>=/path ./install.sh
set -euo pipefail

# ─── CONFIG — the installer-builder skill fills in only this block ─────────────
PKG_NAME="example"                   # archive/display name; also names the backup dir
DEST_ENV="DEST"                      # env var that overrides the destination root
DEST_DEFAULT="$HOME/.example"        # default destination root
DATA_FILES=()                        # paths (relative to dest) never created/overwritten
EXEC_GLOBS=("*.sh")                  # filename globs under dest to chmod +x after install
# ─── END CONFIG ───────────────────────────────────────────────────────────────

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PAYLOAD="$SRC/payload"
DEST="${!DEST_ENV:-$DEST_DEFAULT}"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$DEST/.${PKG_NAME}-backup-$STAMP"

[ -d "$PAYLOAD" ] || { echo "error: payload/ not found next to install.sh" >&2; exit 1; }
echo "Installing $PKG_NAME → $DEST"
backed_up=0

# The payload mirrors the destination tree — install is a generic walk-and-copy.
while IFS= read -r f; do
  rel="${f#"$PAYLOAD"/}"
  dst="$DEST/$rel"
  mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ]; then
    mkdir -p "$(dirname "$BACKUP/$rel")"
    cp -p "$dst" "$BACKUP/$rel"
    backed_up=1
    echo "  updated  $rel  (previous backed up)"
  else
    echo "  added    $rel"
  fi
  cp "$f" "$dst"
done < <(find "$PAYLOAD" -type f)

# Restore executable bits — a download or move commonly drops them.
for g in "${EXEC_GLOBS[@]:-}"; do
  [ -z "$g" ] && continue
  find "$DEST" -type f -name "$g" -exec chmod +x {} \; 2>/dev/null || true
done

# User-data files are never created or overwritten — only noted if absent.
for d in "${DATA_FILES[@]:-}"; do
  [ -z "$d" ] && continue
  [ -e "$DEST/$d" ] || echo "  note: $DEST/$d not present — user-managed, not created by this installer."
done

echo
[ "$backed_up" -eq 1 ] && echo "Existing files were backed up under: $BACKUP"
echo "$PKG_NAME installed."
